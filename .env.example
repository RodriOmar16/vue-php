# URL base de la API (api-reservas)
VITE_API_URL=http://localhost:3000/api

# Dirección del sitio público (sitio-reservas), para el botón «Ver mi página» del panel
# VITE_SITIO_URL=http://localhost:3001

# Solo para desarrollo: copiar a .env.development.local (git lo ignora) para entrar sin escribir la clave.
# Es el login normal de la API; no existe ningún atajo y estas variables se eliminan del build de producción.
# VITE_DEV_EMAIL=tu@email.com
# VITE_DEV_PASSWORD=tu-clave
